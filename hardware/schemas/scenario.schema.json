{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drone-studio.local/schemas/scenario.schema.json",
  "title": "Simulation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "name",
    "description",
    "tags",
    "airframe",
    "duration_s",
    "seed",
    "environment",
    "initial",
    "pilot",
    "assertions"
  ],
  "properties": {
    "kind": { "const": "scenario" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "airframe": { "$ref": "common.schema.json#/$defs/id" },
    "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
    "seed": { "type": "integer", "minimum": 0 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["altitude_asl_m", "temperature_c"],
      "properties": {
        "altitude_asl_m": { "type": "number", "minimum": -400, "maximum": 6000 },
        "temperature_c": { "type": "number", "minimum": -40, "maximum": 60 },
        "steady_wind_mps": { "$ref": "common.schema.json#/$defs/vec3" },
        "turbulence": { "enum": ["none", "light", "moderate", "severe"] },
        "gusts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "duration_s", "ramp_s", "velocity_mps"],
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "duration_s": { "type": "number", "exclusiveMinimum": 0 },
              "ramp_s": { "type": "number", "minimum": 0 },
              "velocity_mps": { "$ref": "common.schema.json#/$defs/vec3" }
            }
          }
        }
      }
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position_m": { "$ref": "common.schema.json#/$defs/vec3" },
        "yaw_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "battery_soc": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "kind"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "kind": { "enum": ["motor_degradation", "rc_loss", "gyro_bias_step"] },
          "motor": { "$ref": "common.schema.json#/$defs/id" },
          "thrust_scale": { "type": "number", "minimum": 0, "maximum": 1 },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "bias_dps": { "$ref": "common.schema.json#/$defs/vec3" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "motor_degradation" } } },
            "then": { "required": ["motor", "thrust_scale"] }
          },
          {
            "if": { "properties": { "kind": { "const": "gyro_bias_step" } } },
            "then": { "required": ["bias_dps"] }
          }
        ]
      }
    },
    "pilot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "arm": { "type": "boolean" },
          "mode": { "enum": ["angle", "althold"] },
          "roll": { "type": "number", "minimum": -1, "maximum": 1 },
          "pitch": { "type": "number", "minimum": -1, "maximum": 1 },
          "yaw": { "type": "number", "minimum": -1, "maximum": 1 },
          "throttle": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "params": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+(\\.[a-z_]+)*$" },
      "additionalProperties": { "type": "number" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "altitude_within",
              "max_tilt_deg",
              "attitude_error_rms_deg",
              "no_failsafe",
              "failsafe_triggered",
              "armed_at",
              "disarmed_at_end",
              "touchdown_speed_max_mps",
              "battery_min_v",
              "step_response",
              "max_motor_saturation_pct",
              "horizontal_speed_max_mps"
            ]
          },
          "window": { "$ref": "common.schema.json#/$defs/window" },
          "t": { "type": "number", "minimum": 0 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "axis": { "enum": ["roll", "pitch", "yaw"] },
          "target_deg": { "type": "number" },
          "max_overshoot_pct": { "type": "number", "minimum": 0 },
          "rise_time_max_s": { "type": "number", "exclusiveMinimum": 0 },
          "settle_s": { "type": "number", "exclusiveMinimum": 0 },
          "tolerance_deg": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
