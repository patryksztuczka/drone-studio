{
  "name": "drone-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "check": "vp check",
    "check:deps": "node scripts/check-exact-deps.mjs",
    "check:suppressions": "node scripts/suppressions.mjs",
    "typecheck": "effect-tsgo tsc -b",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "verify": "vp check && pnpm env:check && pnpm check:deps && pnpm check:suppressions && pnpm check:doc-pins && pnpm check:knip && pnpm typecheck && pnpm test && pnpm check:rust && pnpm build",
    "env:check": "varlock load",
    "init:project": "node scripts/init.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "check:changed": "node scripts/check-changed.mjs",
    "check:doc-pins": "node scripts/check-doc-pins.mjs",
    "check:knip": "knip --no-progress",
    "check:web-boot": "node scripts/web-boot.mjs",
    "sources:fetch": "node scripts/fetch-sources.mjs",
    "dev:status": "node scripts/dev.mjs status",
    "github:apply": "node scripts/github-apply.mjs",
    "browser": "agent-browser",
    "pr-evidence": "node .agents/skills/file-pr/scripts/pr-evidence.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "agent-browser": "0.41.0",
    "knip": "6.44.0",
    "typescript": "catalog:",
    "varlock": "1.24.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.5.0 <27",
    "pnpm": "11.28.9"
  },
  "packageManager": "pnpm@11.28.9"
}
