# Every variable the desktop app reads through Effect Config, plus the dev ports. Checked in, never holds a secret.
# Put local values in .env.local (gitignored); `pnpm dev` and `pnpm dev:desktop` set what they need themselves.
# Defaults live in code (Config.withDefault); this file declares names, types and what is sensitive.
# `pnpm env:check` validates the current environment against it.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Which environment files load: .env.production and .env.production.local for a packaged build.
# @type=enum(development, production)
APP_ENV=development

# Port of this checkout's web dev server. `pnpm dev` derives it from the checkout path; set it to override.
# @type=port
DEV_WEB_PORT=

# The desktop app (apps/desktop). `pnpm dev:desktop` sets DESKTOP_RENDERER_URL and DESKTOP_USER_DATA_DIR.
# Dev server the window opens; without it the window serves apps/web/dist itself.
# @type=url
DESKTOP_RENDERER_URL=

# Where the desktop app keeps its cookies, cache and single-instance lock; one per checkout in development.
DESKTOP_USER_DATA_DIR=

# A running drone-engine the window attaches to; without it the window builds and starts its own on a free port.
# @type=url
DESKTOP_ENGINE_URL=

# Smoke mode: path of a PNG. The window stays hidden, waits until the Studio has a connected engine and a rendered frame, writes the capture there and quits (exit code 1 on failure).
DESKTOP_SMOKE=

# Repository root drone-engine reads hardware/ and writes runs/ in; defaults to two folders above apps/desktop.
DRONE_ROOT=

# Port of this checkout's drone-engine under `pnpm dev`, one above DEV_WEB_PORT unless set.
# @type=port
DEV_ENGINE_PORT=

# Engine URL the web dev server hands the Studio; `pnpm dev` sets it. A ?engine= parameter on the page wins.
# @type=url
VITE_DRONE_ENGINE_URL=
